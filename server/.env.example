# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB. Transactions (used from Phase 3) need a replica set; a single-node
# replica set is fine for development: mongod --replSet rs0, then rs.initiate().
MONGODB_URI=mongodb://127.0.0.1:27017/sfa_cms?replicaSet=rs0

# The web app's origin. Used for CORS and the CSRF origin check.
CLIENT_ORIGIN=http://localhost:5173

# Session signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_TTL_HOURS=10
# Defaults to true in production. Set false only for local HTTP.
# COOKIE_SECURE=false
# Set true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Placeholder numbering: CMP-2026-000001. Pending company confirmation.
COMPLAINT_NUMBER_PREFIX=CMP
COMPLAINT_NUMBER_PAD=6

# Attachments. STORAGE_DIR must not be served by any web server.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
UPLOAD_MAX_MB=10
UPLOAD_MAX_FILES=5

LOG_LEVEL=info

# Used only by `npm run seed`.
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email. MAIL_DRIVER=file writes each email to MAIL_OUTBOX_DIR as a .eml file
# (open with any mail client). Set MAIL_DRIVER=smtp and the SMTP_* values for real delivery.
MAIL_DRIVER=file
MAIL_FROM="Customer Relationship Management <no-reply@example.com>"
MAIL_OUTBOX_DIR=./mail-outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false   # true for port 465
# SMTP_USER=
# SMTP_PASSWORD=

# Background email sending and retries
NOTIFY_POLL_SECONDS=15
NOTIFY_MAX_ATTEMPTS=5
# Public URL of the web app, used for "View complaint record" links.
# APP_BASE_URL=https://complaints.example.com

# WhatsApp. WHATSAPP_DRIVER=mock runs the chatbot without Meta; use the
# "WhatsApp simulator" page in the app to talk to it. For real WhatsApp set
# WHATSAPP_DRIVER=cloud and all four values below (see docs/WHATSAPP.md).
WHATSAPP_DRIVER=mock
# WHATSAPP_VERIFY_TOKEN=          # any long random string; also entered in the Meta app
# WHATSAPP_APP_SECRET=            # Meta app secret, used to verify webhook signatures
# WHATSAPP_ACCESS_TOKEN=          # permanent system-user token
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_SBUS=AHP-Rumicare,AHP-Poultry,AHP-Aqua
WHATSAPP_CATEGORIES=Packaging,Product quality,Efficacy,Labelling,Other
RATE_LIMIT_PER_MINUTE=300
